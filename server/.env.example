# Server
NODE_ENV=development
PORT=5000
CLIENT_ORIGIN=http://localhost:3000

# Database
# Local:  mongodb://localhost:27017/launchpad
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/launchpad?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/launchpad

# Redis
# Local:              redis://localhost:6379
# Managed/TLS (e.g. Upstash, Redis Cloud, ElastiCache with TLS): rediss://default:<password>@<host>:<port>
REDIS_URL=redis://localhost:6379

# JWT
JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace-with-a-different-long-random-refresh-secret
JWT_REFRESH_EXPIRES_IN=30d

# Cookies
REFRESH_COOKIE_NAME=lp_refresh_token
